{
  "name": "wows-devkit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "pack:check": "pnpm -r exec npm pack --dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "git-tag": "changeset git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
